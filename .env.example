# Root directory containing SKILL.md files (required)
SKILLS_DIR=/path/to/your/skills

# Comma-separated list of valid API keys (required)
# Pass one of these as _api_key in every tool call
API_KEYS=your-secret-key-1,your-secret-key-2

# Redis connection URL (optional — falls back to disk-only if unavailable)
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default: 3600 = 1 hour)
REDIS_TTL=3600

# Directory for user overlay skills (optional)
OVERLAYS_DIR=/path/to/your/overlays
